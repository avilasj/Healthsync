<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Sync - Gerenciador de Usuários</title>
    <link rel="stylesheet" href="/stylesheets/styles.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
    <style>
        .user-table-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .user-table {
            width: 100%;
            max-width: 900px;
            border-radius: 18px;
            overflow: hidden;
            margin: 0;
            background: #232323;
            box-shadow: 0 4px 32px 0 rgba(0,0,0,0.18), 0 0 0 2px #333;
        }
        .user-table table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background: #232323;
        }
        .user-table thead {
            background: #232323;
        }
        .user-table th, .user-table td {
            color: #fff;
            background: #232323;
            padding: 18px 22px;
        }
        .user-table th {
            font-weight: 800;
            font-size: 1.22rem;
            border-bottom: 2.5px solid #444;
            letter-spacing: 1px;
            text-shadow: 0 2px 8px #111;
        }
        .user-table th:first-child {
            border-top-left-radius: 18px;
        }
        .user-table th:last-child {
            border-top-right-radius: 18px;
        }
        .user-table tr {
            border-bottom: 1px solid #333;
        }
        .user-table tr:nth-child(even) {
            background: #232323;
        }
        .user-table tr:nth-child(odd) {
            background: #18191a;
        }
        .user-table td.nome {
            font-weight: bold;
            color: #fff;
            letter-spacing: 0.5px;
        }
        .user-table td {
            vertical-align: middle;
            font-size: 1.08rem;
        }
        .user-table td:last-child {
            min-width: 220px;
        }
        .user-action-btn {
            padding: 7px 16px;
            border-radius: 14px;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            margin-right: 6px;
            background: #232323;
            color: #fff;
            border: 1.5px solid #444;
            transition: background 0.2s, color 0.2s, border 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 8px #11111a11;
        }
        .user-action-btn.edit { border-color: #1de9b6; }
        .user-action-btn.edit:hover { background: #1de9b6; color: #232323; box-shadow: 0 0 8px #1de9b6; }
        .user-action-btn.delete { border-color: #ff6b6b; }
        .user-action-btn.delete:hover { background: #ff6b6b; color: #232323; box-shadow: 0 0 8px #ff6b6b; }
        .user-action-btn.reset { border-color: #4ECDC4; }
        .user-action-btn.reset:hover { background: #4ECDC4; color: #232323; box-shadow: 0 0 8px #4ECDC4; }
        .search-bar {
            width: 100%;
            max-width: 420px;
            margin: 0 auto 32px auto;
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 32px;
            padding: 10px 22px 10px 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.10);
            border: 2.5px solid #1de9b6;
            position: relative;
            transition: border 0.2s;
        }
        .search-bar:focus-within {
            border: 2.5px solid #4ECDC4;
            box-shadow: 0 4px 18px #1de9b633;
        }
        .search-bar .search-icon {
            color: #1de9b6;
            font-size: 1.3rem;
            margin-right: 10px;
        }
        .search-bar input {
            width: 100%;
            background: transparent;
            border: none;
            color: #232323;
            font-size: 1.08rem;
            outline: none;
            font-family: inherit;
        }
        .search-bar input::placeholder {
            color: #888;
            font-style: italic;
        }
        .dashboard-panel {
            background: #232323;
            border-radius: 28px;
            padding: 56px 40px;
            min-width: 520px;
            min-height: 370px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 8px 32px 0 rgba(0,0,0,0.18);
            backdrop-filter: blur(8px);
            border: 1.5px solid #232323;
        }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="brand">Health Sync</div>
        <div class="dashboard-title">Gerenciador de usuários</div>
    </div>
    <div class="container">
        <aside class="sidebar">
            <div class="logo">
                <img src="/images/logo.png" alt="HealthSync Logo">
                <span>HEALTHSYNC</span>
            </div>
            <nav>
                <ul>
                    <li><a href="/admin/admindashboard">Dashboard</a></li>
                    <li class="active"><a href="/admin/usuarios">Gerenciador de usuários</a></li>
                </ul>
            </nav>
            <div class="sidebar-bottom">
                <a href="/admin" class="logout-link">Sair</a>
            </div>
        </aside>
        <main class="main-content">
            <div class="dashboard-panel">
                <form class="search-bar" method="get" action="/admin/usuarios">
                    <span class="search-icon"><i class="fas fa-search"></i></span>
                    <input type="text" placeholder="Buscar por usuário..." name="busca" value="<%= termoBusca || '' %>">
                </form>
                <div class="user-table-container">
                    <div class="user-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Email</th>
                                    <th>Senha</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% usuarios.forEach(function(usuario, idx) { %>
                                    <tr id="linha-<%= usuario.usucodigo %>">
                                        <td class="nome"><%= usuario.usunome %></td>
                                        <td class="email"><%= usuario.usuemail %></td>
                                        <td class="senha"><%= usuario.ususenha %></td>
                                        <td style="white-space:nowrap;">
                                            <button type="button" class="user-action-btn edit" onclick="editarLinha(<%= usuario.usucodigo %>)">Editar</button>
                                            <button type="button" class="user-action-btn delete" onclick="excluirUsuario(<%= usuario.usucodigo %>)">Excluir</button>
                                            <form action="/admin/usuarios/<%= usuario.usucodigo %>/resetar-senha" method="post" style="display:inline;">
                                                <button type="submit" class="user-action-btn reset">Resetar senha</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script>
        function editarLinha(usucodigo) {
            const linha = document.getElementById('linha-' + usucodigo);
            const nome = linha.querySelector('.nome').innerText;
            const email = linha.querySelector('.email').innerText;
            const senha = linha.querySelector('.senha').innerText;
            linha.innerHTML = `
                <td><input id="nome-editar-${usucodigo}" value="${nome}" style="width:100%;padding:4px 8px;border-radius:6px;border:1px solid #888;"></td>
                <td><input id="email-editar-${usucodigo}" value="${email}" style="width:100%;padding:4px 8px;border-radius:6px;border:1px solid #888;"></td>
                <td><input id="senha-editar-${usucodigo}" value="${senha}" style="width:100%;padding:4px 8px;border-radius:6px;border:1px solid #888;"></td>
                <td style="white-space:nowrap;">
                    <button type="button" class="user-action-btn edit" onclick="salvarEdicao(${usucodigo})">Salvar</button>
                    <button type="button" class="user-action-btn reset" onclick="window.location.reload()">Cancelar</button>
                </td>
            `;
        }
        async function salvarEdicao(usucodigo) {
            const nome = document.getElementById('nome-editar-' + usucodigo).value;
            const email = document.getElementById('email-editar-' + usucodigo).value;
            const senha = document.getElementById('senha-editar-' + usucodigo).value;
            await fetch(`/admin/usuarios/${usucodigo}/editar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usunome: nome, usuemail: email, ususenha: senha })
            });
            window.location.reload();
        }
        async function excluirUsuario(usucodigo) {
            if (!confirm('Tem certeza que deseja excluir este usuário?')) return;
            await fetch(`/admin/usuarios/${usucodigo}/excluir`, { method: 'POST' });
            const linha = document.getElementById('linha-' + usucodigo);
            if (linha) linha.remove();
        }
    </script>
</body>
</html> 